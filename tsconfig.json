{
  "compilerOptions": {
    "declaration": true,
    "experimentalDecorators": true,
    "inlineSources": true,
    "module": "commonjs",
    "noImplicitAny": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "sourceMap": true,
    "paths": {
      "*": ["./node_modules/*"]
    },
    "target": "es6",
    "types": ["node"]
  },
  "include": [
    "./src/**/*",
    ".eslintrc.js"
  ],
  "typedocOptions": {
    "entryPoints": ["./src/index.ts"],
    "out": "docs/",
    "excludeInternal": true,
    "excludePrivate": true,
    "disableSources": true,
    "validation": {
      "invalidLink": true,
      "notDocumented": true
    }
  }
}
